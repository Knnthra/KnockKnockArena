<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Module 9 tests: the three new TCP events byte for byte (PlayerDamaged, PlayerDied,
    RocketExploded), the rocket entity in the snapshot, the server's pickup table
    (pickups.json), and the server's input rule from Modul 6 (GameWorld, one Tick at a
    time). Handed out to the students; they run it against THEIR OWN Shared
    project and THEIR OWN server project:

      dotnet test tests/KnockKnockArena.Tests.M09

    See README.md next to this file.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The code under test: YOUR shared project, and YOUR server project for the pickup
       table (it is server-only: the client never predicts pickups). The test project sits
       in tests/ next to src/, so these relative paths work in your repo exactly as here. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\KnockKnockArena.Shared\KnockKnockArena.Shared.csproj" />
    <ProjectReference Include="..\..\src\KnockKnockArena.Server\KnockKnockArena.Server.csproj" />
  </ItemGroup>

  <!-- The answer key's pickup table, next to the test dll. -->
  <ItemGroup>
    <None Include="pickups.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
