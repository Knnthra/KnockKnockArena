<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Module 12 tests: configuration from environment variables (the Docker way) - read by YOUR
    server, started as a real process with only environment variables, arguments on top, and
    the public ports it advertises behind port mapping (in /api/status and the LAN answer) -
    and YOUR Dockerfile and .dockerignore, read as files: what goes into the image and what
    must never. Handed out to the students; they run it against THEIR OWN projects:

      dotnet test tests/KnockKnockArena.Tests.M12

    No Docker needed. See README.md next to this file.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The code under test: YOUR shared project, and YOUR server - built next to the test dll
       and started as a process by ServerProcess. The test project sits in tests/ next to
       src/, so these relative paths work in your repo exactly as they do here. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\KnockKnockArena.Shared\KnockKnockArena.Shared.csproj" />
    <ProjectReference Include="..\..\src\KnockKnockArena.Server\KnockKnockArena.Server.csproj" />
  </ItemGroup>

  <!-- The answer key's arena and weapon table: the server is started with these files. -->
  <ItemGroup>
    <None Include="arena.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="weapons.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
