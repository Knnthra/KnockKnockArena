<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Module 10 tests: the REST API from the outside - status codes, content types and the
    config response's content - against YOUR server, started as a real process on free
    ports, plus the shared ServerStatus parser and Quick join's choice. Handed out to the
    students; they run it against THEIR OWN Shared and server projects:

      dotnet test tests/KnockKnockArena.Tests.M10

    See README.md next to this file.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The code under test: YOUR shared project, and YOUR server - built next to the test dll
       and started as a process by ServerFixture. The test project sits in tests/ next to
       src/, so these relative paths work in your repo exactly as they do here. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\KnockKnockArena.Shared\KnockKnockArena.Shared.csproj" />
    <ProjectReference Include="..\..\src\KnockKnockArena.Server\KnockKnockArena.Server.csproj" />
  </ItemGroup>

  <!-- The answer key's arena and weapon table: the server is started with these files, and
       the config response must carry them byte for byte. -->
  <ItemGroup>
    <None Include="arena.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="weapons.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
