<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Module 7 tests: SnapshotPacket with pickup entities byte for byte, and the students'
    InterpolationBuffer (Unity netcode, but plain C#) sampled at fixed server ticks.
    Handed out to the students; they run it against THEIR OWN Shared project and THEIR OWN
    InterpolationBuffer.cs:

      dotnet test tests/KnockKnockArena.Tests.M07

    See README.md next to this file.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The code under test: YOUR shared project. The test project sits in tests/ next to
       src/, so this relative path works in your repo exactly as it does here. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\KnockKnockArena.Shared\KnockKnockArena.Shared.csproj" />
  </ItemGroup>

  <!-- YOUR InterpolationBuffer: it lives in the Unity netcode folder, but it is plain C#
       (no UnityEngine), so it compiles here too. -->
  <ItemGroup>
    <Compile Include="..\..\KnockKnockClient\Assets\Scripts\Networking\InterpolationBuffer.cs" Link="InterpolationBuffer.cs" />
  </ItemGroup>

</Project>
